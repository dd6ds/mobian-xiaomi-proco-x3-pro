# Config fragment applied on top of the postmarketOS sm8150 config.
# Merged with scripts/kconfig/merge_config.sh.

# Android ABL cannot boot the EFI zboot image; we need a plain Image.gz
# with the DTB appended, so "make bindeb-pkg" must install Image.gz.
# CONFIG_EFI_ZBOOT is not set

# Debian kernel naming: linux-image-<ver>-sm8150-vayu
CONFIG_LOCALVERSION="-sm8150-vayu"
# CONFIG_LOCALVERSION_AUTO is not set

# No debug info: keeps the build fast and avoids a huge linux-image-*-dbg package
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT is not set
# CONFIG_DEBUG_INFO_BTF is not set

# Things systemd / Debian userspace expects
CONFIG_CGROUPS=y
CONFIG_CGROUP_BPF=y
CONFIG_MEMCG=y
CONFIG_INOTIFY_USER=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EPOLL=y
CONFIG_FHANDLE=y
CONFIG_AUTOFS_FS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_SECCOMP=y
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_DEVTMPFS=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_ZSTD=y

# Root filesystem + encryption
CONFIG_EXT4_FS=y
CONFIG_DM_CRYPT=y
CONFIG_BLK_DEV_DM=y

# USB networking for SSH over USB (Mobian uses NetworkManager + configfs)
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_NCM=y

# Module signing is not used (no Debian signing key)
# CONFIG_MODULE_SIG is not set
CONFIG_SYSTEM_TRUSTED_KEYS=""
CONFIG_SYSTEM_REVOCATION_KEYS=""
