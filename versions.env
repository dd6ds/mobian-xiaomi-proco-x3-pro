# Pinned sources. Every value can be overridden from the environment,
# e.g.  KERNEL_TAG=v7.1.0-sm8150 ./build.sh
# (checksums are only enforced for the pinned default versions)

# Mainline SM8150 kernel (same tree postmarketOS uses for vayu)
: "${KERNEL_TAG:=v7.0.0-sm8150}"
: "${KERNEL_URL:=https://gitlab.postmarketos.org/soc/qualcomm-sm8150/linux/-/archive/${KERNEL_TAG}/linux-${KERNEL_TAG}.tar.gz}"
KERNEL_TAG_DEFAULT="v7.0.0-sm8150"
KERNEL_SHA512_DEFAULT="c1bdb11a9ad8be826ec5781e239c60ad92d6bb3a2d6b0adff8ef1f1e334bc6889ab91683257691ba3155f976011cd37969be379d509c9f928f4f85753e95635e"

# Vendor firmware for vayu (ADSP/CDSP/modem/GPU zap/WLAN/touchscreen)
: "${FIRMWARE_COMMIT:=9240ae83a70189c7513666a245a72de2c7aaf698}"
: "${FIRMWARE_URL:=https://gitlab.com/alinasrullayev/firmware-xiaomi-vayu/-/archive/${FIRMWARE_COMMIT}/firmware-xiaomi-vayu-${FIRMWARE_COMMIT}.tar.gz}"
FIRMWARE_COMMIT_DEFAULT="9240ae83a70189c7513666a245a72de2c7aaf698"
FIRMWARE_SHA512_DEFAULT="dc94db8d3988c9c7cf64abea0801488e08f528cb6cc7693954f025d160347be8d900823461b3b51bee553f1876b093e8a87dc04ca9b648f82b5609feea2ec57a"

# Mobian build system (debos recipes)
: "${MOBIAN_RECIPES_URL:=https://salsa.debian.org/Mobian-team/mobian-recipes.git}"
: "${MOBIAN_RECIPES_REF:=a4fff86693de2526e4de1d0497b74b2400986e6f}"

# Container images used for the build
: "${KERNEL_BUILDER_IMAGE:=debian:trixie}"
: "${DEBOS_IMAGE:=godebos/debos:latest}"
